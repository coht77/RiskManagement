{
  "name": "RiskManagement",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/dev-cap-tools": "^1.31.0",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-riskmgn": "cds watch --open riskmgn/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "kind": "dummy",
        "users": {
          "alice": {
            "roles": [
              "RiskViewer",
              "RiskManager",
              "authenticated-user"
            ]
          }
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "BusinessPartnerA2X": {
        "kind": "odata-v2",
        "model": "srv/external/BusinessPartnerA2X",
        "[production]": {
          "credentials": {
            "path": "s4hanacloud/sap/opu/odata/sap/API_BUSINESS_PARTNER",
            "destination": "apihub_sandbox"
          }
        },
        "csrf": true,
        "csrfInBatch": true
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/riskmgn"
  ]
}